/xbox/x_exe/Debug
*.ncb
*.suo

# CMake binary/intermediate dir -- fully ignored.
/build

# Game/ is the runtime dir (the exe + Data live here; run the game from here). We track ONLY
# the loose .q / .qn script SOURCES the game loads under -loosescripts. The exe, dlls, the
# multi-GB game assets (Textures/Models/Music/...) and the compiled .qb stay ignored.
# (Regenerate the .qb from the .q with tools\build_scripts.bat.)
/Game/*
!/Game/Data
/Game/Data/*
!/Game/Data/scripts
/Game/Data/scripts/**/*.qb

