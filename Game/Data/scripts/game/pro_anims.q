	{ anims=[ Ped_M_Idle1 Ped_M_Idle1 Ped_M_Idle1 Ped_M_Idle1 Ped_M_Idle1 Ped_M_Idle1 Ped_M_Idle1 Ped_M_Lookright ]}
]

