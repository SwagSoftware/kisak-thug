script Ped_Ollie Anim=Ollie
	Obj_PlayAnim anim=<Anim> From=0 To=10
	Obj_Jump gravity=-400 speed=150
	Obj_WaitAnimFinished
endscript

script Ped_SketchyFlip
	Obj_PlayAnim Random (@anim=heelflip @anim=inwardheelflip @anim=_360flip @anim=varialkickflip @anim=_360ShoveIt @anim=hardflip)
	Obj_Rotate time = .5, relative = (0, 10, 0)
	Obj_WaitJumpFinished
	Obj_PlayAnim Random (@anim=Land @anim=SketchyLand @anim=SketchyLand1 @anim=RunOutQuick @anim=Land @anim=Land @anim=Land)
	Obj_WaitAnimFinished
	if Obj_AnimEquals [SketchyLand1 SketchyLand]
		Obj_PlayAnim anim=CrouchIdleToIdle
		Obj_WaitAnimFinished
	endif
endscript

script Ped_Land	LandAnim=Land
	Obj_PlayAnim Anim=AirIdle
	Obj_WaitJumpFinished
	Obj_PlayAnim Anim=<LandAnim>
	Obj_WaitAnimFinished
endscript

script	Ped_Manual ManualAnim=ManualRange
	Obj_PlayAnim Anim=<ManualAnim> From=26 To=34 Speed=.5
	begin
		Obj_PlayAnim Anim=<ManualAnim> From=34 To=24 Speed=.33
		Obj_WaitAnimFinished
		Obj_PlayAnim Anim=<ManualAnim> From=24 To=34 Speed=.5
		Obj_WaitAnimFinished
	repeat 2
	Obj_PlayAnim Anim=<ManualAnim> From=34 To=End Speed=.5
	Obj_WaitAnimFinished
endscript

