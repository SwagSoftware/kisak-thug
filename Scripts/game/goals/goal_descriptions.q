//New Goal Description 
//Help Eric get his board back *******************************************//


Sparrow_NJ_Goal_Collect5_camanim01_skater = 
[
    "What up Eric?  "
]
Sparrow_NJ_Goal_Collect5_camanim02 = 
[
    "Hey!  Help me out here...  "
]
Sparrow_NJ_Goal_Collect5_camanim03 = 
[
    "I was just skating, minding my own, and the dealers grabbed my board! They tore it apart and threw the pieces up on the roof...  "
]
Sparrow_NJ_Goal_Collect5_camanim04 = 
[
    "My knee is wrecked! Could you grab them for me?  "
]
Sparrow_NJ_Goal_Collect5_camanim05_skater = 
[
    "Aw, man!  "
]
Sparrow_NJ_Goal_Collect5 = 
[
    "Here, I'll hold your deck... (Use \b3 to Jump and \bf to grab onto stuff and then pull yourself up. (\b7))  "
]                

//New Goal Description 
//Help Eric part 2 *****************************//

Sparrow_NJ_Goal_Gaps5_CamAnim01 =
[
    "Thanks! - here's your deck back...  "
    "Hey - while I'm getting my ride set up again, let's see if you remember a couple things...  "
]                

Sparrow_NJ_Goal_Gaps5_CamAnim02 =
[
    "You can get off the board to get over terrain "
    "that would normally be hard or impossible to skate over.\n  "
]                

Sparrow_NJ_Goal_Gaps5 = 
[
    "So give this a try - first get off your board, then jump over the barriers.\n  "
    "(Tap \mm to get on or off the board)"
]                

