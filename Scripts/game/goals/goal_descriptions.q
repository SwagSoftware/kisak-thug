//Goal = Gaps10
//Pro = SkeezoTP 
SkeezoTP_SD_Goal_Gaps10_CamAnim01 = [ "Ralphie's partied a bit too hard.\n He climbed up that tower saying he was going to do an Acid Drop onto the quarter pipe down here.\n But now he's chickened out!" ]

